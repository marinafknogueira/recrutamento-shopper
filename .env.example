# Copie este arquivo para ".env" e preencha os valores antes de rodar o sistema.

# ========== Google OAuth ==========
# ID do cliente OAuth do Google (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=coloque_aqui_o_client_id.apps.googleusercontent.com

# Dominio corporativo do Google Workspace (ex: shopper.com.br)
# Usado para bloquear login de contas Google fora da empresa.
COMPANY_DOMAIN=shopper.com.br

# E-mail que sera cadastrado automaticamente como Admin na primeira vez que o servidor rodar
ADMIN_EMAIL=marina@shopper.com.br

# Chave secreta usada para assinar o cookie de sessao
# Em producao, use: openssl rand -base64 32
JWT_SECRET=troque-esta-chave-por-um-texto-aleatorio-longo

# ========== Ambiente ==========
NODE_ENV=development
PORT=3000

# ========== Banco de dados (PostgreSQL) ==========
# Use a DATABASE_URL do Supabase (producao) ou localhost (desenvolvimento)

# SUPABASE (Producao - recomendado):
# 1. Crie um projeto em supabase.com
# 2. Vá em Settings > Database > Connection String
# 3. Selecione "URI" e copie a URL
# 4. Substitua [YOUR-PASSWORD] pela senha do projeto
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres

# OU Local (Desenvolvimento):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/recrutamento

# Cloud SQL (legado - apenas se usar Google Cloud SQL):
# INSTANCE_CONNECTION_NAME=projeto:regiao:instancia
# DB_USER=recrutamento_app
# DB_PASSWORD=
# DB_NAME=recrutamento
